# Copy to .env for local development: cp .env.example .env
# In staging/production these are set in the host (Railway), never committed.

# Required, no default. The app refuses to start without it.
# One of: development | test | production
NODE_ENV=development

PORT=4000

# Runtime connection used by the API. The values below match docker-compose.yml (host port 5433).
# On Neon this is the POOLED connection string, with ?sslmode=require
DATABASE_URL=postgres://goal:goal@localhost:5433/goal_intl

# Used only by `npm run migrate:*`. On Neon this is the DIRECT (unpooled) string. Same as above locally.
DATABASE_URL_DIRECT=postgres://goal:goal@localhost:5433/goal_intl

# The one browser origin allowed to call the API (CORS). Per environment.
WEB_ORIGIN=http://localhost:3000

# Local development only: skips admin authentication.
# The app refuses to start with this set to true unless NODE_ENV=development.
AUTH_DISABLED=true

# Signs the staff sign-in tokens. Without it, the admin is locked (unless AUTH_DISABLED=true locally).
# Not needed locally while AUTH_DISABLED=true. Elsewhere a random secret, e.g. `openssl rand -base64 48`,
# set in Railway, never in the web app. Changing it signs everyone out.
# Accounts live in the users table: create the first admin with `npm run users:create-admin`.
AUTH_TOKEN_SECRET=
