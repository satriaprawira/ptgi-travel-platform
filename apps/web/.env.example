# Base URL for the NestJS API (see the Tech Stack Recommendation doc).
# Set this per-environment in Vercel (Preview scope = staging, Production scope = production).
# Staging example:    https://api-staging.book.yourdomain.com
# Production example: https://api.book.yourdomain.com
# Local (apps/api `npm run start:dev`): http://127.0.0.1:4000  — no trailing /v1, the client adds it.
NEXT_PUBLIC_API_URL=
