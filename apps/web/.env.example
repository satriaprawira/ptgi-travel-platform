# Base URL for the NestJS API (see the Tech Stack Recommendation doc).
# Set this per-environment in Vercel (Preview scope = staging, Production scope = production).
# Staging example:    https://api-staging.book.yourdomain.com
# Production example: https://api.book.yourdomain.com
# Local (apps/api `npm run start:dev`): http://127.0.0.1:4000  — no trailing /v1, the client adds it.
NEXT_PUBLIC_API_URL=

# Optional: Goal International's WhatsApp for the floating chat button and "Need help?" link, in
# international format (e.g. +81 70-3258-0333). Defaults to that number when unset (lib/content.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: the customer site's live address, for canonical links, /sitemap.xml, /robots.txt and social
# previews. Read at build time. Defaults to https://www.pickupairport.online (lib/content.ts).
NEXT_PUBLIC_SITE_URL=
